# Add infrastructure only after Egypt-specific provider, region, and data-flow review.
# Never commit production credentials or real CV/profile data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Configure markets enabled for your Adzuna API account.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Format: country-code:currency (e.g. gb:GBP). Confirm supported markets with Adzuna.
ADZUNA_MARKETS=

# Public employer job-board identifiers, as slug:Company Label,slug:Company Label
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
